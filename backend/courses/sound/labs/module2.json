{
  "labId": "module2",
  "title": "Medium Lab",
  "emoji": "🌫️",
  "tagline": "Sound Needs a Medium",
  "difficulty": "Physics",
  "duration": "15–20 min",
  "badge": "Medium Master",
  "objectives": [
    "Show sound needs a medium",
    "Compare sound speed in solids, liquids, gases",
    "Explain why space is silent"
  ],
  "stages": [
    {
      "type": "welcome",
      "title": "The Vacuum Trap",
      "xp": 10,
      "narration": "Baron Mute seals a bell in a vacuum jar. Learn why it goes silent to free fragment 2!",
      "steps": [
        {
          "emoji": "🫙",
          "text": "A ringing bell sits inside a sealed glass jar."
        },
        {
          "emoji": "🌀",
          "text": "The Baron pumps out all the air…"
        },
        {
          "emoji": "🤖",
          "text": "Echo Bot: 'Watch what happens to the sound!'"
        }
      ],
      "cta": "Start the Experiment"
    },
    {
      "type": "sort",
      "title": "Can Sound Travel Through It?",
      "xp": 20,
      "prompt": "Sort each thing by whether sound can travel through it.",
      "pass": 0.8,
      "columns": [
        {
          "id": "yes",
          "label": "Sound Travels",
          "emoji": "🔊"
        },
        {
          "id": "no",
          "label": "No Sound",
          "emoji": "🔇"
        }
      ],
      "cards": [
        {
          "id": "air",
          "label": "Air",
          "emoji": "🌬️",
          "column": "yes"
        },
        {
          "id": "water",
          "label": "Water",
          "emoji": "💧",
          "column": "yes"
        },
        {
          "id": "wood",
          "label": "Wood",
          "emoji": "🪵",
          "column": "yes"
        },
        {
          "id": "metal",
          "label": "Metal Rail",
          "emoji": "🛤️",
          "column": "yes"
        },
        {
          "id": "vacuum",
          "label": "Vacuum (empty space)",
          "emoji": "🌌",
          "column": "no"
        },
        {
          "id": "space",
          "label": "Outer Space",
          "emoji": "🚀",
          "column": "no"
        }
      ],
      "note": "Sound needs a medium (solid, liquid or gas). A vacuum has none, so it stays silent."
    },
    {
      "type": "choose",
      "title": "How Fast Does Sound Travel?",
      "xp": 15,
      "prompt": "Rank how fast sound moves through each medium.",
      "options": [
        {
          "id": "fast",
          "label": "Fastest",
          "emoji": "🏃"
        },
        {
          "id": "medium",
          "label": "Medium",
          "emoji": "🚶"
        },
        {
          "id": "slow",
          "label": "Slowest",
          "emoji": "🐢"
        }
      ],
      "tasks": [
        {
          "id": "solid",
          "label": "Through a solid metal rail",
          "emoji": "🛤️",
          "answer": "fast",
          "explain": "Tightly-packed particles carry sound fastest."
        },
        {
          "id": "liquid",
          "label": "Through water",
          "emoji": "💧",
          "answer": "medium",
          "explain": "Liquids are slower than solids, faster than gases."
        },
        {
          "id": "gas",
          "label": "Through air",
          "emoji": "🌬️",
          "answer": "slow",
          "explain": "Gases have far-apart particles, so slowest."
        }
      ]
    },
    {
      "type": "quiz",
      "title": "Mini-Boss: Escape the Vacuum",
      "xp": 30,
      "prompt": "Score 80% to carry the sound out and grab fragment 2!",
      "pass": 0.8,
      "questions": [
        {
          "q": "Sound cannot travel through…",
          "options": [
            "a vacuum",
            "water"
          ],
          "answer": 0,
          "explain": "A vacuum has no medium."
        },
        {
          "q": "Sound travels fastest in…",
          "options": [
            "solids",
            "gases"
          ],
          "answer": 0,
          "explain": "Solids carry sound fastest."
        },
        {
          "q": "Space is silent because…",
          "options": [
            "there is no medium",
            "it is too dark"
          ],
          "answer": 0,
          "explain": "No air means no medium to carry sound."
        },
        {
          "q": "In a storm you see lightning first because…",
          "options": [
            "light is faster than sound",
            "sound happens later"
          ],
          "answer": 0,
          "explain": "Light travels much faster than sound."
        },
        {
          "q": "A reflected sound heard again is an…",
          "options": [
            "echo",
            "amplitude"
          ],
          "answer": 0,
          "explain": "A reflected sound is an echo."
        }
      ]
    },
    {
      "type": "rewards",
      "title": "Bell Fragment 2 Recovered!",
      "xp": 20,
      "badge": "Medium Master",
      "messages": [
        "🏅 You earned the Medium Master badge",
        "🔔 Harmony Bell: 2 of 8 fragments recovered",
        "Sound rushes back through the air!"
      ]
    }
  ]
}
