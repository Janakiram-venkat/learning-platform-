{
  "labId": "module5",
  "title": "Wave Lab",
  "emoji": "〰️",
  "tagline": "Describing Sound Waves",
  "difficulty": "Physics",
  "duration": "15–20 min",
  "badge": "Wave Wizard",
  "objectives": [
    "Define amplitude, frequency and time period",
    "Use frequency = 1 ÷ time period",
    "Read a sound wave"
  ],
  "stages": [
    {
      "type": "welcome",
      "title": "Reading the Waves",
      "xp": 10,
      "narration": "Fragment 5 is locked behind a wave puzzle. Learn to measure a sound to solve it!",
      "steps": [
        {
          "emoji": "📈",
          "text": "Echo Bot shows a wiggly sound wave on a screen."
        },
        {
          "emoji": "👦",
          "text": "Arjun: 'What do all these measurements mean?'"
        },
        {
          "emoji": "🎵",
          "text": "Maestra Sonata: 'Time to become a Wave Wizard!'"
        }
      ],
      "cta": "Enter the Wave Lab"
    },
    {
      "type": "choose",
      "title": "Amplitude or Frequency?",
      "xp": 20,
      "prompt": "Decide which property each description belongs to.",
      "options": [
        {
          "id": "amp",
          "label": "Amplitude",
          "emoji": "📏"
        },
        {
          "id": "freq",
          "label": "Frequency",
          "emoji": "🔁"
        }
      ],
      "tasks": [
        {
          "id": "size",
          "label": "How BIG the vibration is",
          "emoji": "📐",
          "answer": "amp",
          "explain": "Amplitude is the size of the vibration."
        },
        {
          "id": "persec",
          "label": "How many oscillations per second",
          "emoji": "⏱️",
          "answer": "freq",
          "explain": "Frequency is oscillations per second."
        },
        {
          "id": "hz",
          "label": "Measured in hertz (Hz)",
          "emoji": "📶",
          "answer": "freq",
          "explain": "Frequency is measured in Hz."
        },
        {
          "id": "rest",
          "label": "Distance moved from rest position",
          "emoji": "↔️",
          "answer": "amp",
          "explain": "Amplitude is the distance from the rest position."
        }
      ]
    },
    {
      "type": "choose",
      "title": "Frequency ↔ Time Period",
      "xp": 15,
      "prompt": "Use frequency = 1 ÷ time period to pick each answer.",
      "options": [
        {
          "id": "a",
          "label": "0.5 s / 2 Hz",
          "emoji": "🅰️"
        },
        {
          "id": "b",
          "label": "0.25 s / 4 Hz",
          "emoji": "🅱️"
        },
        {
          "id": "c",
          "label": "0.2 s / 5 Hz",
          "emoji": "🇨"
        }
      ],
      "tasks": [
        {
          "id": "t1",
          "label": "Frequency = 2 Hz. Time period = ?",
          "emoji": "⏱️",
          "answer": "a",
          "explain": "1 ÷ 2 = 0.5 s."
        },
        {
          "id": "t2",
          "label": "Frequency = 4 Hz. Time period = ?",
          "emoji": "⏱️",
          "answer": "b",
          "explain": "1 ÷ 4 = 0.25 s."
        },
        {
          "id": "t3",
          "label": "5 oscillations in 1 second. Time period = ?",
          "emoji": "⏱️",
          "answer": "c",
          "explain": "Frequency 5 Hz → 1 ÷ 5 = 0.2 s."
        }
      ]
    },
    {
      "type": "quiz",
      "title": "Mini-Boss: Solve the Wave Puzzle",
      "xp": 30,
      "prompt": "Score 80% to unlock fragment 5!",
      "pass": 0.8,
      "questions": [
        {
          "q": "Frequency is measured in…",
          "options": [
            "hertz",
            "metres"
          ],
          "answer": 0,
          "explain": "Frequency is in hertz (Hz)."
        },
        {
          "q": "Amplitude is…",
          "options": [
            "the size of the vibration",
            "the number per second"
          ],
          "answer": 0,
          "explain": "Amplitude = size of the vibration."
        },
        {
          "q": "Time period is the time for…",
          "options": [
            "one oscillation",
            "one hundred oscillations"
          ],
          "answer": 0,
          "explain": "One complete oscillation."
        },
        {
          "q": "Frequency 4 Hz → time period…",
          "options": [
            "0.25 s",
            "4 s"
          ],
          "answer": 0,
          "explain": "1 ÷ 4 = 0.25 s."
        },
        {
          "q": "High frequency means the time period is…",
          "options": [
            "small",
            "large"
          ],
          "answer": 0,
          "explain": "They are reciprocals."
        }
      ]
    },
    {
      "type": "rewards",
      "title": "Bell Fragment 5 Recovered!",
      "xp": 20,
      "badge": "Wave Wizard",
      "messages": [
        "🏅 You earned the Wave Wizard badge",
        "🔔 Harmony Bell: 5 of 8 fragments recovered",
        "The wave puzzle unlocks with a satisfying chime!"
      ]
    }
  ]
}
