  "stages": [
    {
      "type": "welcome",
      "title": "The Muffled City",
      "xp": 10,
      "narration": "The Baron muffles and detunes every sound. Master loudness and pitch to fix them!",
      "steps": [
        {
          "emoji": "🔉",
          "text": "Every sound is a faint, flat whisper."
        },
        {
          "emoji": "🎛️",
          "text": "Echo Bot hands you the master sound controls."
        },
        {
          "emoji": "🎵",
          "text": "Maestra Sonata: 'Tune it perfectly, hero!'"
        }
      ],
      "cta": "Enter the Lab"
    },
    {
      "type": "sort",
      "title": "Loudness or Pitch?",
      "xp": 20,
      "prompt": "Sort each change by whether it affects loudness or pitch.",
      "pass": 0.8,
      "columns": [
        {
          "id": "loud",
          "label": "Loudness (amplitude)",
          "emoji": "🔊"
        },
        {
          "id": "pitch",
          "label": "Pitch (frequency)",
          "emoji": "🎵"
        }
      ],
      "cards": [
        {
          "id": "hard",
          "label": "Hitting a drum harder",
          "emoji": "🥁",
          "column": "loud"
        },
        {
          "id": "soft",
          "label": "Playing more softly",
          "emoji": "🔉",
          "column": "loud"
        },
        {
          "id": "decibel",
          "label": "Measured in decibels",
          "emoji": "📢",
          "column": "loud"
        },
        {
          "id": "fast",
          "label": "Vibrating faster",
          "emoji": "⚡",
          "column": "pitch"
        },
        {
          "id": "high",
          "label": "A high whistle note",
          "emoji": "🎶",
          "column": "pitch"
        },
        {
          "id": "hertz",
          "label": "Set by frequency (Hz)",
          "emoji": "📶",
          "column": "pitch"
        }
      ],
      "note": "Loudness comes from amplitude; pitch comes from frequency. Two separate ideas!"
    },
    {
      "type": "choose",
      "title": "Higher or Lower Pitch?",
      "xp": 15,
      "prompt": "Faster vibration = higher pitch. Predict each sound.",
      "options": [
        {
          "id": "high",
          "label": "Higher pitch",
          "emoji": "🔼"
        },
        {
          "id": "low",
          "label": "Lower pitch",
          "emoji": "🔽"
        }
      ],
      "tasks": [
        {
          "id": "mosquito",
          "label": "A mosquito's fast wings",
          "emoji": "🦟",
          "answer": "high",
          "explain": "Fast vibration → high pitch."
        },
        {
          "id": "drum",
          "label": "A big slow drum",
          "emoji": "🥁",
          "answer": "low",
          "explain": "Slow vibration → low pitch."
        },
        {
          "id": "whistle",
          "label": "A shrill whistle",
          "emoji": "🎵",
          "answer": "high",
          "explain": "High frequency → high pitch."
        }
      ]
    },
    {
      "type": "quiz",
      "title": "Mini-Boss: Tune the World",
      "xp": 30,
      "prompt": "Score 80% to retune every sound and win fragment 6!",
      "pass": 0.8,
      "questions": [
        {
          "q": "Loudness depends on…",
          "options": [
            "amplitude",
            "frequency"
          ],
          "answer": 0,
          "explain": "Bigger amplitude = louder."
        },
        {
          "q": "Pitch depends on…",
          "options": [
            "frequency",
            "amplitude"
          ],
          "answer": 0,
          "explain": "Higher frequency = higher pitch."
        },
        {
          "q": "Hitting a drum harder changes its…",
          "options": [
            "loudness",
            "pitch"
          ],
          "answer": 0,
          "explain": "A harder hit gives more amplitude = louder."
        },
        {
          "q": "Loudness is measured in…",
          "options": [
            "decibels",
            "hertz"
          ],
          "answer": 0,
          "explain": "Loudness is in decibels (dB)."
        },
        {
          "q": "A child's higher voice comes from…",
          "options": [
            "faster vibrating (shorter) cords",
            "bigger amplitude"
          ],
          "answer": 0,
          "explain": "Higher pitch = higher frequency."
        }
      ]
    },
    {
      "type": "rewards",
      "title": "Bell Fragment 6 Recovered!",
      "xp": 20,
      "badge": "Pitch Perfect",
      "messages": [
        "🏅 You earned the Pitch Perfect badge",
